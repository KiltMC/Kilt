{
    "schemaVersion": 1,
    "id": "kilt_create_compat",
    "version": "${version}",
    "name": "Kilt: Create Fabric Compat",
    "description": "A compatibility layer to help bridge Create Fabric and any Create Forge addons.",
    "authors": [
        "BluSpring"
    ],
    "contact": {
        "sources": "https://github.com/KiltMC/Kilt",
        "issues": "https://github.com/KiltMC/Kilt/issues"
    },
    "license": "MIT",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
    },
    "mixins": [
        "kilt-create-compat.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "${minecraft_version}",
        "fabric-language-kotlin": ">=${fabric_kotlin_version}",
        "kilt": "*"
    },
    "custom": {
        "modmenu": {
            "parent": "kilt"
        }
    }
}