{
  "schemaVersion": 1,
  "id": "kilt",
  "version": "${version}",
  "name": "Kilt",
  "description": "Allows the loading of NeoForge mods in the Fabric ecosystem. Very experimental.",
  "authors": [
    "BluSpring",
    "AlphaMode"
  ],
  "provides": [
    "neoforge"
  ],
  "contact": {
    "repo": "https://github.com/KiltMC/Kilt",
    "issues": "https://github.com/KiltMC/Kilt/issues"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/kilt/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "xyz.bluspring.kilt.client.KiltClient"
    ],
    "main": [
      "xyz.bluspring.kilt.Kilt"
    ],
    "server": [
      "xyz.bluspring.kilt.server.dedicated.KiltDedicatedServer"
    ],
    "mm:early_risers": [
      "xyz.bluspring.kilt.loader.asm.KiltEarlyRiser"
    ],
    "mixinsquared-adjuster": [
      "xyz.bluspring.kilt.loader.mixin.KiltAnnotationAdjuster"
    ],
    "mixinsquared": [
      "xyz.bluspring.kilt.loader.mixin.KiltMixinCanceller"
    ],
    "afl:instrumentation": [
      "xyz.bluspring.kilt.loader.asm.KiltInstrumentationHandler"
    ]
  },
  "mixins": [
    "Kilt.mixins.json",
    "kilt_forge_injects.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "mm": ">=${fabric_asm_version}",
    "forgeconfigapiport": ">=${forge_config_version}",
    "architectury": ">=${architectury_version}"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_339": ["net/neoforged/neoforge/client/extensions/IAbstractWidgetExtension"],
      "net/minecraft/class_1087": ["net/neoforged/neoforge/client/extensions/IBakedModelExtension"],
      "net/minecraft/class_827": ["net/neoforged/neoforge/client/extensions/IBlockEntityRendererExtension"],
      "net/minecraft/class_5294": ["net/neoforged/neoforge/client/extensions/IDimensionSpecialEffectsExtension"],
