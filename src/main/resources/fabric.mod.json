      "net/minecraft/class_332": ["net/neoforged/neoforge/client/extensions/IGuiGraphicsExtension"],
      "net/minecraft/class_304": ["net/neoforged/neoforge/client/extensions/IKeyMappingExtension"],
      "net/minecraft/class_3908": ["net/neoforged/neoforge/client/extensions/IMenuProviderExtension"],
      "net/minecraft/class_310": ["net/neoforged/neoforge/client/extensions/IMinecraftExtension"],
      "net/minecraft/class_7775": ["net/neoforged/neoforge/client/extensions/IModelBakerExtension"],
      "net/minecraft/class_4587": ["net/neoforged/neoforge/client/extensions/IPoseStackExtension"],
      "net/minecraft/class_4588": ["net/neoforged/neoforge/client/extensions/IVertexConsumerExtension"],
      "net/minecraft/class_3665": ["net/neoforged/neoforge/client/extensions/ModelStateExtension"],

      "net/minecraft/class_1688": ["net/neoforged/neoforge/common/extensions/IAbstractMinecartExtension"],
      "net/minecraft/class_161$class_162": ["net/neoforged/neoforge/common/extensions/IAdvancementBuilderExtension"],
