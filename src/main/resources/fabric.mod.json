      "net/minecraft/class_2241": ["net/neoforged/neoforge/common/extensions/IBaseRailBlockExtension"],
      "net/minecraft/class_1920": ["net/neoforged/neoforge/common/extensions/IBlockAndTintGetterExtension"],
      "net/minecraft/class_2586": ["net/neoforged/neoforge/common/extensions/IBlockEntityExtension"],
      "net/minecraft/class_2248": ["net/neoforged/neoforge/common/extensions/IBlockExtension"],
      "net/minecraft/class_1922": ["net/neoforged/neoforge/common/extensions/IBlockGetterExtension"],
