      "net/minecraft/class_2792": ["net/neoforged/neoforge/common/extensions/IServerGamePacketListenerExtension"],
      "net/minecraft/class_2474$class_5124": ["net/neoforged/neoforge/common/extensions/ITagAppenderExtension"],
