{
  "schemaVersion": 1,
  "id": "kilt",
  "version": "${version}",
  "name": "Kilt",
  "description": "Allows the loading of NeoForge mods in the Fabric ecosystem. Very experimental.",
  "authors": [
    "BluSpring",
    "AlphaMode"
  ],
  "provides": [
    "neoforge"
  ],
  "contact": {
    "repo": "https://github.com/KiltMC/Kilt",
    "issues": "https://github.com/KiltMC/Kilt/issues"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/kilt/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "xyz.bluspring.kilt.client.KiltClient"
    ],
    "main": [
      "xyz.bluspring.kilt.Kilt"
    ],
    "server": [
      "xyz.bluspring.kilt.server.dedicated.KiltDedicatedServer"
    ],
    "mm:early_risers": [
      "xyz.bluspring.kilt.loader.asm.KiltEarlyRiser"
    ],
    "mixinsquared-adjuster": [
      "xyz.bluspring.kilt.loader.mixin.KiltAnnotationAdjuster"
    ],
    "mixinsquared": [
      "xyz.bluspring.kilt.loader.mixin.KiltMixinCanceller"
    ],
    "afl:instrumentation": [
      "xyz.bluspring.kilt.loader.asm.KiltInstrumentationHandler"
    ]
  },
  "mixins": [
    "Kilt.mixins.json",
    "kilt_neo_injects.mixins.json",
    "kilt_neo_modifications.mixins.json"
  ],
