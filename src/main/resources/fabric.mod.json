      "net/minecraft/class_4590": ["net/neoforged/neoforge/common/extensions/ITransformationExtension"]
    },
    "lithium:options": {
      "mixin.entity.collisions.fluid": false
    }
  },
  "breaks": {
    "quilt_loader": "*",
    "async": "*",
    "creativecore": "<2.12.33",
    "embeddium": "*"
  },
  "accessWidener": "kilt.accesswidener"
}
